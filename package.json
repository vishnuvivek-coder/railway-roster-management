{
    "name":  "railway-roster-manager",
    "version":  "1.0.0",
    "description":  "Railway Staff Link-Rotation Roster Manager",
    "main":  "src/backend/server.js",
    "scripts":  {
                    "start":  "node src/backend/server.js",
                    "build":  "npm --prefix src/frontend install \u0026\u0026 npm --prefix src/frontend run build",
                    "postinstall":  "npm --prefix src/frontend install \u0026\u0026 npm --prefix src/frontend run build",
                    "dev:backend":  "tsx src/backend/server.ts",
                    "dev:frontend":  "npm run dev --prefix src/frontend",
                    "dev":  "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
                    "migrate:mysql":  "tsx src/backend/migrate_to_mysql.ts",
                    "typecheck":  "tsc --noEmit \u0026\u0026 npm --prefix src/frontend run build"
                },
    "dependencies":  {
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^18.0.7",
                         "express":  "^4.19.2",
                         "jsonwebtoken":  "^9.0.3",
                         "mysql2":  "^3.24.5",
                         "tsx":  "^4.23.15",
                         "typescript":  "^7.0.2"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^26.6.5",
                            "concurrently":  "^10.0.3"
                        },
    "optionalDependencies": {
        "sqlite3": "^5.1.7"
    }
}
