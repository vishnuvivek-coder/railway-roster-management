# ============================================================================
# RAILWAY ROSTER MANAGER — ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Port (default: 5000)
PORT=5000

# JWT Authentication Secret
JWT_SECRET=railway_roster_luxury_editorial_secret_2026

# ============================================================================
# DATABASE SELECTION: 'mysql' OR 'sqlite'
# ============================================================================
# Set DB_TYPE=mysql to use your dedicated MySQL server.
# If DB_TYPE=sqlite or left blank without MySQL credentials, SQLite (roster.db) is used as a fallback.
DB_TYPE=mysql

# MySQL Server Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=railway_roster

# Alternative: Single Connection URI (e.g. for Railway, PlanetScale, Cloud SQL, AWS RDS)
# DATABASE_URL=mysql://root:password@localhost:3306/railway_roster
